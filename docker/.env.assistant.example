# ============================================================================
# Example .env for docker-compose.assistant.yml
# ----------------------------------------------------------------------------
# Copy this file to `.env` at the repo root and fill in the values:
#
#     cp docker/.env.assistant.example .env
#
# Then bring the stack up:
#
#     docker compose -f docker/docker-compose.assistant.yml --env-file .env up -d --build
# ============================================================================

# ---- Web ----------------------------------------------------------------
# Public URL of the web app. Use the address users open in the browser.
NEXTAUTH_URL=http://localhost:3000

# Secret used to sign auth cookies. Generate with:
#   openssl rand -hex 32
NEXTAUTH_SECRET=replace-me-with-a-long-random-string

# Host port to expose. Change if 3000 is already in use.
KARAKEEP_PORT=3000

# ---- Meilisearch (vector store for RAG) ---------------------------------
# Master key shared by Meilisearch and Karakeep. Generate with:
#   openssl rand -hex 32
MEILI_MASTER_KEY=replace-me-with-a-long-random-string

# ---- LLM provider (pick ONE) --------------------------------------------
# Option A: OpenAI (cloud)
OPENAI_API_KEY=sk-...
# Optional overrides — defaults are fine for most users:
# INFERENCE_TEXT_MODEL=gpt-4.1-mini
# EMBEDDING_TEXT_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# Option B: Ollama (self-hosted / offline) — comment out OPENAI_API_KEY first
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# INFERENCE_TEXT_MODEL=llama3.1:8b
# EMBEDDING_TEXT_MODEL=nomic-embed-text
# EMBEDDING_DIMENSIONS=768

# ---- Assistant tuning (optional) ----------------------------------------
# These are enabled by default in docker-compose.assistant.yml. Override
# here if you want to disable them.
# EMBEDDING_ENABLE_AUTO_INDEXING=true
# INFERENCE_ENABLE_AUTO_TAGGING=true
# INFERENCE_ENABLE_AUTO_SUMMARIZATION=true

# ---- Access control (optional) ------------------------------------------
# Single-user / invite-only setups: lock the signup form after creating
# your account. Existing users can still sign in.
# DISABLE_SIGNUPS=true
# DISABLE_PASSWORD_AUTH=true   # if you only want OAuth

# ---- Build platform (optional) ------------------------------------------
# Defaults to linux/arm64 (Apple Silicon native, fast). Switch to
# linux/amd64 if you're on an Intel host or want to push the image to an
# x86_64 server.
# KARAKEEP_PLATFORM=linux/arm64
